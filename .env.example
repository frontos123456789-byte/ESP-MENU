# Ключ OpenRouter (https://openrouter.ai/keys). Бесплатный аккаунт подходит для :free моделей.
# С серверным ключом разрешены только бесплатные модели (id заканчивается на :free).
OPENROUTER_API_KEY=

# Необязательно: код доступа к сайту. Если задан, без него /api/chat и коннекторы не работают.
# Рекомендую включить, если ставишь серверный ключ и сайт публичный.
ACCESS_CODE=

# Необязательно: другой адрес OpenRouter-совместимого API (для тестов).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
